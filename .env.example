# Copy this file to .env. Do not commit the resulting .env file.
# Generate a URL-safe password, for example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
POSTGRES_DB=urlshortener
POSTGRES_USER=urlapp

# DOMAIN must resolve to this server before starting with --profile production.
DOMAIN=go.example.com
VITE_SHORT_URL_BASE=https://go.example.com

# The web container is bound to this loopback-only host port for diagnostics.
APP_PORT=8080

# Leave empty when the UI and API share the same origin (the default deployment).
CORS_ALLOWED_ORIGINS=
